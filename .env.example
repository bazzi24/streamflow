# ============================================================
# MySQL
# ============================================================
MYSQL_ROOT_PASSWORD=change_me_generate_a_strong_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ============================================================
# MySQL App User (used by FastAPI / Spark ETL)
# Create this user by running the CREATE USER command in init.sql
# ============================================================
DB_USER=streamflow_app
DB_PASSWORD=change_strong_password

# ============================================================
# Spark JDBC  (MySQL)
# ============================================================
# RAW database — data DB contains streaming + corporation + market tables
RAW_DB_URL=jdbc:mysql://mysql:3306/data?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&charset=utf8mb4
# DW database  — warehouse DB contains dim + fact tables
DW_DB_URL=jdbc:mysql://mysql:3306/warehouse?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&charset=utf8mb4
DB_DRIVER=com.mysql.cj.jdbc.Driver
MYSQL_JAR=/streamflow/lib/mysql-connector-j-8.0.33.jar

# ============================================================
# Kafka
# ============================================================
# Advertised host that producers/consumers use to reach the broker.
# For local Docker Compose: use "kafka" (service name).
# For remote/cloud: replace with the public IP or hostname of the Docker host.
KAFKA_ADVERTISED_HOST=kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ============================================================
# Spark cluster
# ============================================================
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=4G
SPARK_WORKER_CORES=2

# ============================================================
# SSI API credentials
# ============================================================
auth_type=Bearer
consumerID=your_consumerID_here
consumerSecret=your_consumerSecret_here
url=https://fc-data.ssi.com.vn/
stream_url=https://fc-datahub.ssi.com.vn/

# ============================================================
# JWT — REQUIRED
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================
# CORS — comma-separated origins
# ============================================================
CORS_ORIGINS=http://localhost:3000

# ============================================================
# Exposed host ports
# ============================================================
EXPOSE_KAFKA_PORT=9092
EXPOSE_KAFKA_UI_PORT=8080
EXPOSE_MYSQL_PORT=3306
EXPOSE_FLINK_JOB_PORT=8081
EXPOSE_SPARK_MASTER_PORT=7077
EXPOSE_SPARK_MASTER_UI_PORT=8082
