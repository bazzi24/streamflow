# ============================================================
# MySQL
# ============================================================
MYSQL_ROOT_PASSWORD=stream_flow
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ============================================================
# Spark JDBC  (MySQL)
# ============================================================
# RAW database — data DB contains streaming + corporation + market tables
RAW_DB_URL=jdbc:mysql://mysql:3306/data?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DW database  — warehouse DB contains dim + fact tables
DW_DB_URL=jdbc:mysql://mysql:3306/warehouse?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=stream_flow
DB_DRIVER=com.mysql.cj.jdbc.Driver

# ============================================================
# Kafka
# ============================================================
# Advertised host that producers/consumers use to reach the broker.
# For local Docker Compose: use "kafka" (service name).
# For remote/cloud: replace with the public IP or hostname of the Docker host.
KAFKA_ADVERTISED_HOST=kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ============================================================
# Spark cluster
# ============================================================
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=4G
SPARK_WORKER_CORES=2

# ============================================================
# SSI API credentials
# ============================================================
auth_type=Bearer
consumerID=your_consumerID
consumerSecret=your_consumerSecret
url=https://fc-data.ssi.com.vn/
stream_url=https://fc-datahub.ssi.com.vn/

# ============================================================
# Exposed host ports
# ============================================================
EXPOSE_KAFKA_PORT=9092
EXPOSE_KAFKA_UI_PORT=8080
EXPOSE_MYSQL_PORT=3306
EXPOSE_FLINK_JOB_PORT=8081
EXPOSE_SPARK_MASTER_PORT=7077
EXPOSE_SPARK_MASTER_UI_PORT=8082
