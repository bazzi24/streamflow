# ============================================================
# WARNING: SECURITY-CRITICAL SETTINGS
# ============================================================
# All passwords and secret keys MUST be randomly generated.
# Never use placeholder values in production!
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

# ============================================================
# MySQL Root Password (CRITICAL)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================
MYSQL_ROOT_PASSWORD=GENERATE_A_STRONG_RANDOM_PASSWORD_MIN_32_CHARS
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ============================================================
# MySQL App User (used by FastAPI / Spark ETL)
# Create this user by running the CREATE USER command in init.sql
# Use a separate strong password from MYSQL_ROOT_PASSWORD
# ============================================================
DB_USER=streamflow_app
# REQUIRED: Must match the password in init.sql. Use a strong random password.
DB_PASSWORD=GENERATE_A_STRONG_RANDOM_PASSWORD_MIN_32_CHARS

# ============================================================
# Spark JDBC  (MySQL)
# ============================================================
# RAW database — data DB contains streaming + corporation + market tables
RAW_DB_URL=jdbc:mysql://mysql:3306/data?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&charset=utf8mb4
# DW database  — warehouse DB contains dim + fact tables
DW_DB_URL=jdbc:mysql://mysql:3306/warehouse?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&charset=utf8mb4
DB_DRIVER=com.mysql.cj.jdbc.Driver
MYSQL_JAR=/streamflow/lib/mysql-connector-j-8.0.33.jar

# ============================================================
# Kafka
# ============================================================
# Advertised host that producers/consumers use to reach the broker.
# For local Docker Compose: use "kafka" (service name).
# For remote/cloud: replace with the public IP or hostname of the Docker host.
KAFKA_ADVERTISED_HOST=kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ============================================================
# Kafka SSL/TLS (production)
# ============================================================
# Security protocol: SSL for TLS encryption, PLAINTEXT for dev
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# SSL certificate paths (mounted from ./kafka-ssl directory)
KAFKA_SSL_CAFILE=/var/private/ssl/ca.pem
KAFKA_SSL_CERTFILE=/var/private/ssl/kafka.crt
KAFKA_SSL_KEYFILE=/var/private/ssl/kafka.key

# SASL/PLAIN authentication (for SSL connections)
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=kafka
KAFKA_SASL_PASSWORD=GENERATE_KAFKA_SASL_PASSWORD

# Kafka SSL port (for production SSL connections)
EXPOSE_KAFKA_SSL_PORT=9093

# ============================================================
# Spark cluster
# ============================================================
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=4G
SPARK_WORKER_CORES=2

# ============================================================
# SSI API credentials (obtain from https://doc.ssi.com.vn/)
# ============================================================
auth_type=Bearer
consumerID=YOUR_SSI_CONSUMER_ID_HERE
consumerSecret=YOUR_SSI_CONSUMER_SECRET_HERE
url=https://fc-data.ssi.com.vn/
stream_url=https://fc-datahub.ssi.com.vn/

# ============================================================
# JWT — REQUIRED AND MUST BE SECURE
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# THIS IS THE SINGLE MOST IMPORTANT SECRET FOR YOUR API
# Store it securely and never commit the actual value to version control
# ============================================================
SECRET_KEY=GENERATE_A_64_HEX_CHAR_RANDOM_SECRET_ABSOLUTELY_REQUIRED
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================================
# CORS — comma-separated origins
# ============================================================
CORS_ORIGINS=http://localhost:3000

# ============================================================
# Exposed host ports (for external access configuration)
# ============================================================
EXPOSE_KAFKA_PORT=9092
EXPOSE_KAFKA_UI_PORT=8080
EXPOSE_MYSQL_PORT=3306
EXPOSE_FLINK_JOB_PORT=8081
EXPOSE_SPARK_MASTER_PORT=7077
EXPOSE_SPARK_MASTER_UI_PORT=8082
EXPOSE_API_PORT=8000
EXPOSE_CONSUMER_HEALTH_PORT=8081
