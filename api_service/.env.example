# Database
DB_USER=root
DB_PASSWORD=stream_flow
DB_DRIVER=com.mysql.cj.jdbc.Driver

# MySQL hosts (matching docker-compose service names)
MYSQL_HOST=mysql
MYSQL_PORT=3306

# JDBC-style DW URL — warehouse DB contains dim + fact tables
DW_DB_URL=jdbc:mysql://mysql:3306/warehouse?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# JWT (change this in production!)
SECRET_KEY=streamflow-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
